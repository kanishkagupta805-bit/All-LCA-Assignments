def is_right_angled(a, b, c):
    """
    Checks if a triangle is right-angled given its three sides.
    Uses Pythagoras' theorem: base^2 + perpendicular^2 = hypotenuse^2
    """
   
    sides = sorted([a, b, c])
    x, y, z = sides[0], sides[1], sides[2]
    

    if abs((x**2 + y**2) - z**2) < 1e-9:
        return True
    return False


if __name__ == "__main__":
    print("--- Right-Angled Triangle Checker ---")
    
    try:
        
        side1 = float(input("Enter length of side 1: "))
        side2 = float(input("Enter length of side 2: "))
        side3 = float(input("Enter length of side 3: "))
        
        
        if side1 <= 0 or side2 <= 0 or side3 <= 0:
            print("Error: Side lengths must be greater than zero!")
        else:
           
            if is_right_angled(side1, side2, side3):
                print("Result: Yes, it is a right-angled triangle!")
            else:
                print("Result: No, it is not a right-angled triangle.")
                
    except ValueError:
        print("Invalid input! Please enter numeric values only.")
