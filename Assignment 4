
def add_matrices_lists(matrix1, matrix2):
    rows = len(matrix1)
    cols = len(matrix1[0])
    
    
    result = [[0 for _ in range(cols)] for _ in range(rows)]
    
    
    for i in range(rows):
        for j in range(cols):
            result[i][j] = matrix1[i][j] + matrix2[i][j]
            
    return result


A = [
    [1, 2, 3],
    [4, 5, 6]
]

B = [
    [7, 8, 9],
    [10, 11, 12]
]

sum_matrix = add_matrices_lists(A, B)

print("Matrix Addition using Lists:")
for row in sum_matrix:
    print(row)
