import re

def check_allowed_chars(input_string):
   
    pattern = re.compile(r'^[a-zA-Z0-9]+$')
    
    
    if pattern.match(input_string):
        return True
    else:
        return False


if __name__ == "__main__":
    
    string1 = "Python3Programming"
    string2 = "Hello World!"  # Space aur '!' ki wajah se False dega
    string3 = "123456"

    for s in [string1, string2, string3]:
        if check_allowed_chars(s):
            print(f"'{s}' contains ONLY allowed characters (a-z, A-Z, 0-9).")
        else:
            print(f"'{s}' contains invalid characters or spaces.")
